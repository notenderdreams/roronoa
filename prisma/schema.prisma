model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  role          String?
  banned        Boolean?      @default(false)
  banReason     String?
  banExpires    DateTime?
  studentId     String

  sessions      Session[]
  accounts      Account[]

  foundReports       FoundReport[] @relation("FoundReports")
  confirmedHandovers FoundReport[] @relation("ConfirmedHandovers")

  auditEvents   AuditEvent[]

  @@unique([email])
  @@unique([studentId])
  @@map("user")
}