DATABASE_URL="postgresql://roronoa:roronoa@localhost:5432/roronoa"

# Better Auth: generate with `bunx @better-auth/cli secret`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# seed script (prisma/seed.ts)
ADMIN_EMAIL="admin@iut-dhaka.edu"
ADMIN_PASSWORD="change-me-123"

# Dev only: true = skip email verification (register logs you straight in). Ignored in production.
SKIP_EMAIL_VERIFICATION="false"

# Email via Brevo API. Leave BREVO_API_KEY empty to print emails to the server console.
BREVO_API_KEY=""
MAIL_FROM="Roronoa <you@gmail.com>"

S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="roronoa"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio12345"
# true for local S3 (RustFS), false for R2/S3
S3_FORCE_PATH_STYLE="true"
